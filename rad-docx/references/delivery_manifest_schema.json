{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "katedra_delivery"
    },
    "before": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "mode": {
      "enum": [
        "format_only",
        "metadata_only"
      ]
    },
    "metadata_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "core",
          "custom",
          "application",
          "thumbnail",
          "image_metadata"
        ]
      }
    },
    "render_manifest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "visual_review": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "enum": [
              "JMBAG",
              "dates",
              "signature",
              "CV",
              "administrative"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "before",
    "after",
    "mode",
    "metadata_groups",
    "render_manifest",
    "visual_review",
    "excluded"
  ],
  "additionalProperties": false
}
