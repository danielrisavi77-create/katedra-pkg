{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "katedra_visual_review"
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "render_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_pages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "pending"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "document_sha256",
    "render_manifest_sha256",
    "reviewer",
    "reviewed_pages",
    "decision",
    "notes",
    "reviewed_at"
  ],
  "additionalProperties": false
}
