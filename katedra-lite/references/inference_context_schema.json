{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bindings": {
      "type": "object",
      "properties": {
        "document": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "version_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "version_id",
            "sha256"
          ],
          "additionalProperties": false
        },
        "claims_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "view": {
          "enum": [
            "original_no_revisions",
            "accepted_copy",
            "rejected_copy"
          ]
        }
      },
      "required": [
        "document",
        "claims_sha256",
        "evidence_sha256",
        "sources_sha256",
        "source_files",
        "view"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "origin": {
            "enum": [
              "source",
              "derived"
            ]
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "exact",
                      "approximate",
                      "lower_bound",
                      "upper_bound"
                    ]
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]{0,39})(?:\\.[0-9]{1,40})?$",
                    "maxLength": 82
                  }
                },
                "required": [
                  "kind",
                  "amount"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interval"
                  },
                  "lower": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]{0,39})(?:\\.[0-9]{1,40})?$",
                    "maxLength": 82
                  },
                  "upper": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]{0,39})(?:\\.[0-9]{1,40})?$",
                    "maxLength": 82
                  }
                },
                "required": [
                  "kind",
                  "lower",
                  "upper"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "metric": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "organisation": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "population": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geography": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "organisation",
              "population",
              "geography"
            ],
            "additionalProperties": false
          },
          "measure_status": {
            "enum": [
              "actual",
              "capacity",
              "target",
              "planned",
              "estimate",
              "unknown"
            ]
          },
          "flow_role": {
            "enum": [
              "input",
              "output",
              "stock",
              "not_applicable",
              "unknown"
            ]
          },
          "denominator": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "members": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 1,
                "maxItems": 10000,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "complement_of": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "verified",
                  "pending"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "decision",
              "reviewer"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fact_id",
          "claim_id",
          "origin",
          "evidence_id",
          "locator",
          "value",
          "unit",
          "metric",
          "period",
          "scope",
          "measure_status",
          "flow_role",
          "denominator",
          "members",
          "category",
          "complement_of",
          "review"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "derivation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "operation": {
            "enum": [
              "identity",
              "sum",
              "union",
              "difference",
              "percentage_point_change",
              "relative_change",
              "ratio_percent",
              "yield_percent",
              "complement_percent"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "overlap": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "tolerance": {
            "type": "object",
            "properties": {
              "absolute": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,39})(?:\\.[0-9]{1,40})?$",
                "maxLength": 82
              },
              "reason": {
                "type": "string",
                "maxLength": 2000
              },
              "reviewer": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": [
              "absolute",
              "reason",
              "reviewer"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "derivation_id",
          "operation",
          "inputs",
          "result",
          "tolerance"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    },
    "required_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "required_derivation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 10000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "bindings",
    "facts",
    "derivations",
    "required_fact_ids",
    "required_derivation_ids"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "katedra-inference-context-v1",
  "title": "Typed annotations bound to document and source bytes; not source truth verification"
}
