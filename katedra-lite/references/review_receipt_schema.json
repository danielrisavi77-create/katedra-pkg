{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "katedra-bound-review-receipt-v1",
  "type": "object",
  "required": ["schema_version","kind","scope","status","before","after","reports","coverage","limitations","created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "katedra_bound_review"},
    "scope": {"const": "ledger_evidence_consistency"},
    "status": {"enum": ["pass","blocked","unmeasured","stale"]},
    "before": {"type":"object"},
    "after": {"type":"object"},
    "reports": {"type":"object"},
    "coverage": {
      "type":"object",
      "required":["claims","compared_claims","comparison_edges","whole_document"],
      "properties":{
        "claims":{"type":"integer","minimum":0},
        "compared_claims":{"type":"integer","minimum":0},
        "comparison_edges":{"type":"integer","minimum":0},
        "whole_document":{"const":false}
      },
      "additionalProperties":false
    },
    "limitations":{"type":"array","items":{"type":"string"},"minItems":3},
    "created_at":{"type":"string"}
  },
  "additionalProperties": false
}
